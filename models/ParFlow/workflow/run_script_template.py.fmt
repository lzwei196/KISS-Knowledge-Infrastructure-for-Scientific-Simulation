#!/usr/bin/env python3
"""ParFlow run script for {run_name} -- generated by HydroCraft ParFlow KI.
Grid {nx}x{ny}x{nz}, dx={dx} m, dz={dz0} m uniform, depth {total_depth} m.
Period {start_date}..{end_date} ({total_hours} h), restart offset {start_time_hours} h.
Key structure follows parflow source test/python/washita/LW_Test.py.
Rendered from workflow/run_script_template.py.fmt by s7_solver/generate_parflow_script.py."""
import glob, os
PARFLOW_DIR = os.environ.get("PARFLOW_DIR", "/mnt/disk1/Hydrocraft_server/model/parflow/install")
os.environ["PARFLOW_DIR"] = PARFLOW_DIR
os.environ["PATH"] = os.path.join(PARFLOW_DIR, "bin") + ":" + os.environ.get("PATH", "")
from parflow import Run

run = Run("{run_name}", __file__)
run.FileVersion = 4
run.Process.Topology.P = {p}
run.Process.Topology.Q = {q}
run.Process.Topology.R = {r}

# Grid in local coordinates; georeference lives in domain_definition.json
run.ComputationalGrid.Lower.X = 0.0
run.ComputationalGrid.Lower.Y = 0.0
run.ComputationalGrid.Lower.Z = 0.0
run.ComputationalGrid.NX = {nx}
run.ComputationalGrid.NY = {ny}
run.ComputationalGrid.NZ = {nz}
run.ComputationalGrid.DX = {dx}
run.ComputationalGrid.DY = {dy}
run.ComputationalGrid.DZ = {dz0}

run.GeomInput.Names = "{geominput_names}"
run.GeomInput.domain_input.InputType = "Box"
run.GeomInput.domain_input.GeomName = "domain"
run.Geom.domain.Lower.X = 0.0
run.Geom.domain.Lower.Y = 0.0
run.Geom.domain.Lower.Z = 0.0
run.Geom.domain.Upper.X = {upper_x}
run.Geom.domain.Upper.Y = {upper_y}
run.Geom.domain.Upper.Z = {total_depth}
run.Geom.domain.Patches = "left right front back bottom top"
{indi}

# Permeability in m/hr (dt_pf_001)
run.Geom.Perm.Names = "domain {gnames}"
run.Geom.domain.Perm.Type = "Constant"
run.Geom.domain.Perm.Value = 0.00104
{perm_classes}
run.Perm.TensorType = "TensorByGeom"
run.Geom.Perm.TensorByGeom.Names = "domain"
run.Geom.domain.Perm.TensorValX = 1.0
run.Geom.domain.Perm.TensorValY = 1.0
run.Geom.domain.Perm.TensorValZ = {k_anisotropy}

run.SpecificStorage.Type = "Constant"
run.SpecificStorage.GeomNames = "domain"
run.Geom.domain.SpecificStorage.Value = 1.0e-4

run.Phase.Names = "water"
run.Phase.water.Density.Type = "Constant"
run.Phase.water.Density.Value = 1.0
run.Phase.water.Viscosity.Type = "Constant"
run.Phase.water.Viscosity.Value = 1.0
run.Contaminants.Names = ""
run.Gravity = 1.0

run.TimingInfo.BaseUnit = 1.0
run.TimingInfo.StartCount = {start_count}
run.TimingInfo.StartTime = {start_time_f}
run.TimingInfo.StopTime = {stop_time_f}
run.TimingInfo.DumpInterval = {dump_interval_f}
run.TimeStep.Type = "Constant"
run.TimeStep.Value = {dt_hours}

run.Geom.Porosity.GeomNames = "domain {gnames}"
run.Geom.domain.Porosity.Type = "Constant"
run.Geom.domain.Porosity.Value = 0.43
{porosity_classes}

run.Domain.GeomName = "domain"
run.Phase.water.Mobility.Type = "Constant"
run.Phase.water.Mobility.Value = 1.0
run.Wells.Names = ""

# Cycle must exist BEFORE any BCPressure references it (dt_pf_v003)
run.Cycle.Names = "constant"
run.Cycle.constant.Names = "alltime"
run.Cycle.constant.alltime.Length = 1
run.Cycle.constant.Repeat = -1

run.BCPressure.PatchNames = "left right front back bottom top"
{bcs}
# Overland flow via BC type, NOT Solver.OverlandKinematic (dt_pf_v001)
run.Patch.top.BCPressure.Type = "OverlandFlow"
run.Patch.top.BCPressure.Cycle = "constant"
run.Patch.top.BCPressure.alltime.Value = 0.0

{slopes}

# Mannings in hr*m^(-1/3) (SI / 3600)
run.Mannings.Type = "Constant"
run.Mannings.GeomNames = "domain"
run.Mannings.Geom.domain.Value = {mannings_hr}

# van Genuchten: alpha in 1/m (dt_pf_005)
run.Phase.RelPerm.Type = "VanGenuchten"
run.Phase.RelPerm.GeomNames = "domain {gnames}"
run.Geom.domain.RelPerm.Alpha = 3.6
run.Geom.domain.RelPerm.N = 1.56
{relperm_classes}
run.Phase.Saturation.Type = "VanGenuchten"
run.Phase.Saturation.GeomNames = "domain {gnames}"
run.Geom.domain.Saturation.Alpha = 3.6
run.Geom.domain.Saturation.N = 1.56
run.Geom.domain.Saturation.SRes = 0.18
run.Geom.domain.Saturation.SSat = 1.0
{saturation_classes}

run.PhaseSources.water.Type = "Constant"
run.PhaseSources.water.GeomNames = "domain"
run.PhaseSources.water.Geom.domain.Value = 0.0

{clm}

# IC from PFB, never HydroStaticPatch constants (dt_pf_v008)
run.ICPressure.Type = "PFBFile"
run.ICPressure.GeomNames = "domain"
run.Geom.domain.ICPressure.RefPatch = "top"
run.Geom.domain.ICPressure.FileName = "ic_pressure.pfb"

run.Solver.PrintSubsurfData = True
run.Solver.PrintPressure = True
run.Solver.PrintSaturation = True
run.Solver.PrintMask = True
run.KnownSolution = "NoKnownSolution"

run.Solver = "Richards"
run.Solver.TerrainFollowingGrid = {tfg}
run.Solver.Nonlinear.VariableDz = False
run.Solver.MaxIter = 2500000
run.Solver.Drop = 1e-20
run.Solver.AbsTol = 1e-8
run.Solver.MaxConvergenceFailures = 8
run.Solver.Nonlinear.MaxIter = {nl_max_iter}
run.Solver.Nonlinear.ResidualTol = 1e-6
run.Solver.Nonlinear.EtaChoice = "EtaConstant"
run.Solver.Nonlinear.EtaValue = {eta_value}
run.Solver.Nonlinear.UseJacobian = {use_jacobian}
run.Solver.Nonlinear.DerivativeEpsilon = {derivative_epsilon}
run.Solver.Nonlinear.StepTol = 1e-30
run.Solver.Nonlinear.Globalization = "LineSearch"
run.Solver.Linear.KrylovDimension = {krylov_dim}
run.Solver.Linear.MaxRestarts = 2
run.Solver.Linear.Preconditioner = "PFMGOctree"
run.Solver.Linear.Preconditioner.PCMatrixType = "{pc_matrix_type}"

# Distribute PFB inputs (dt_pf_040)
here = os.path.dirname(os.path.abspath(__file__))
os.chdir(here)
{dist_block}

run.run(working_directory=here)
print("ParFlow run {run_name} completed.")
