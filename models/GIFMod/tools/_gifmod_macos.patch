diff --git a/GIFMod.pro b/GIFMod.pro
index b56cde3..95f84f4 100644
--- a/GIFMod.pro
+++ b/GIFMod.pro
@@ -78,3 +78,17 @@ DEFINES += QT_DEPRECATED_WARNINGS
 #DEFINES += QT_DISABLE_DEPRECATED_BEFORE=0x060000    # disables all the APIs deprecated before Qt 6.0.0
 
 
+
+# Native Apple Silicon build configuration; retains upstream Qt5 model.
+macx {
+    CONFIG -= app_bundle debug debug_and_release debug_and_release_target
+    CONFIG += release
+    QMAKE_CFLAGS -= -pg
+    QMAKE_CXXFLAGS -= -pg -fopenmp
+    QMAKE_LFLAGS -= -pg -fopenmp
+    LIBS -= -lgomp -lpthread
+    QMAKE_CXXFLAGS += -Xpreprocessor -fopenmp
+    INCLUDEPATH += /opt/homebrew/opt/libomp/include
+    LIBS += -L/opt/homebrew/opt/libomp/lib -lomp -framework Accelerate
+    DEFINES += ARMA_USE_LAPACK ARMA_USE_BLAS
+}
