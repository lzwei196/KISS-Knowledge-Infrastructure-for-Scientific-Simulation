template_version: "3.5"

identity:
  model_id: "HYPE"
  scientific_reference_version: "HYPE 5.35.0 (SMHI HYdrological Predictions for the Environment; Lindstrom et al. 2010 process basis)"
  implementation:
    id: "hype-5-35-0"
    version: "5.35.0"
    provenance: "Fortran 90; SMHI HYPE 5.35.0 source (HYSS infrastructure + MODELMODULE.model core), text-file I/O, optional NetCDF."
  ki_class: "forward_model"
  is_family_dag: false
  language: "fortran"
  license: "LGPL-3.0-or-later"
  repo_url: "https://hypeweb.smhi.se/model-water/about-hype-code/"

boundary:
  scope_in:
    - "Subbasin water balance: snow accumulation/melt, soil water (up to 3 layers), evapotranspiration, runoff generation"
    - "Infiltration, surface runoff, percolation, macropore flow, tile drainage, groundwater runoff, upwelling"
    - "Soil temperature and ground frost"
    - "Glacier mass balance (glacier classes)"
    - "Internal river routing (local + main river) with delay and attenuation via MAINDOWN topology"
    - "Lakes and reservoirs: internal/local lakes (ilake), outlet lakes (olake), regulated lakes/dams, layered (stratified) lakes"
    - "Nitrogen cycle (inorganic + organic N) in land, rivers and lakes"
    - "Phosphorus cycle (soluble + particulate P) in land, rivers and lakes"
    - "Organic carbon, tracers, sediment, silica transport"
    - "Water management: irrigation, point/non-point sources, regional groundwater / aquifers"
  scope_out:
    - "Sub-daily process resolution (daily timestep is the operational HydroCraft configuration; some equations have uncertain sub-daily validity)"
    - "External / grid-based routing (routing is internal via MAINDOWN)"
    - "Standing water as a separate storage pool"
    - "Direct land runoff to lakes (all land runoff routes through the local river first)"
    - "Purely physically-based process formulation (algorithms are conceptual; the model is largely manually calibrated)"
  spatial: "distributed-stream"
  temporal: "daily"
  closure: "mass-balance"
  notes: "Mass-conservative water balance per SLC fraction, aggregated to subbasin and routed downstream via MAINDOWN. Substances are carried as concentrations following each water flux plus immobile pools in soil/sediment; N, P, OC, sediment, silica and tracer accounting share the same mass-balance primitives (add_water/remove_water in GeneralWaterConcentration). No surface energy-balance closure: PET is a demand-side flux from one of several conceptual formulations (Jensen-Haise/McGuiness, Hargreaves-Samani, Priestley-Taylor, FAO Penman-Monteith)."

inputs:
  forcing:
    - category: "forcing"
      name: "precipitation (prec)"
      unit: "mm/day"
      source_kind: "forcing"
      model_input_format: "Pobs.txt — tab-separated, header DATE + subbasin/pobsid columns, in forcingdir"
      notes: "Mandatory for every timestep over the full bdate-edate range; no missing (-9999) or negative values; no interpolation/fill for gaps. Header must be line 1 (no !! comment lines) or data silently misparse."
    - category: "forcing"
      name: "air temperature (temp)"
      unit: "degC"
      source_kind: "forcing"
      model_input_format: "Tobs.txt — tab-separated, per subbasin/tobsid, in forcingdir"
      notes: "Mandatory every timestep; assumed to represent the subbasin mean elevation unless elevation-corrected."
    - category: "forcing"
      name: "daily min / max air temperature (tmin/tmax)"
      unit: "degC"
      source_kind: "forcing"
      model_input_format: "TMINobs.txt / TMAXobs.txt"
      notes: "Required by PET models 3-5 (Hargreaves-Samani, Priestley-Taylor, Penman-Monteith)."
    - category: "forcing"
      name: "shortwave radiation"
      unit: "MJ/m^2/day"
      source_kind: "forcing"
      model_input_format: "SWobs.txt"
      notes: "Required by PET models 3-5."
    - category: "forcing"
      name: "relative humidity"
      unit: "fraction"
      source_kind: "forcing"
      model_input_format: "RHobs.txt"
      notes: "Required by PET model 5 (FAO Penman-Monteith) only."
    - category: "forcing"
      name: "wind speed"
      unit: "m/s"
      source_kind: "forcing"
      model_input_format: "Uobs.txt (UWobs/VWobs components)"
      notes: "Required by PET model 5 only."
  parameters:
    - category: "parameter"
      name: "lp (PET reduction limit)"
      unit: "-"
      source_kind: "calibrated"
      model_input_format: "par.txt general parameter"
      notes: "Default 0.8; limits actual ET reduction relative to soil moisture."
    - category: "parameter"
      name: "cevp (PET coefficient)"
      unit: "-"
      source_kind: "calibrated"
      model_input_format: "par.txt land-use-dependent"
      notes: "Highly sensitive control on potential evapotranspiration."
    - category: "parameter"
      name: "cevpam / cevpph (PET seasonal amplitude / phase)"
      unit: "- / days"
      source_kind: "calibrated"
      model_input_format: "par.txt general parameters"
    - category: "parameter"
      name: "ttmp (snow threshold temperature)"
      unit: "degC"
      source_kind: "calibrated"
      model_input_format: "par.txt land-use-dependent"
    - category: "parameter"
      name: "cmlt (degree-day snowmelt factor)"
      unit: "mm/degC/day"
      source_kind: "calibrated"
      model_input_format: "par.txt land-use-dependent"
    - category: "parameter"
      name: "wcwp / wcfc / wcep (wilting point / field capacity / effective porosity)"
      unit: "fraction"
      source_kind: "calibrated"
      model_input_format: "par.txt soil-type-dependent (optionally per layer wcwp1-3 etc.)"
      notes: "Must satisfy wcwp < wcfc < wcep and wcwp+wcfc+wcep < 1; ordering violation gives no percolation."
    - category: "parameter"
      name: "rrcs1 / rrcs2 / rrcs3 (upper / lower / deep recession coefficients)"
      unit: "-"
      source_kind: "calibrated"
      model_input_format: "par.txt (rrcs1/rrcs2 soil-type; rrcs3 general)"
    - category: "parameter"
      name: "srrcs (surface runoff recession coefficient)"
      unit: "-"
      source_kind: "calibrated"
      model_input_format: "par.txt land-use-dependent"
    - category: "parameter"
      name: "rivvel / damp (river velocity / attenuation)"
      unit: "m/s / -"
      source_kind: "calibrated"
      model_input_format: "par.txt general parameters"
    - category: "parameter"
      name: "lake rating-curve and depth parameters (gratk, gratefk, gldepi, gldepol)"
      unit: "- / m"
      source_kind: "calibrated"
      model_input_format: "par.txt lake-region parameters"
    - category: "parameter"
      name: "nutrient process parameters (denitrlu, denitwr, denitwl, minerfn, sedon, sedpp, soilcoh, soilerod)"
      unit: "various (1/day, kg/m2/day, kPa)"
      source_kind: "calibrated"
      model_input_format: "par.txt (genpar/landpar/soilpar) — required when NPC enabled"
      notes: "Process-rate / transport coefficients for the N/P/sediment cycle. If 'substance N P' is enabled but these are absent from par.txt, nutrient processes are silently disabled. (Initial-pool *0 parameters humusn0/fastn0/humusp0/fastp0 are listed under initial_conditions.)"
    - category: "parameter"
      name: "SLC class definitions (landuse, soil, crop, vegtype, special, tiledepth, streamdepth, numlayers, soildepth)"
      unit: "-"
      source_kind: "dataset_lookup"
      model_input_format: "GeoClass.txt — numlayers 1-3 with matching soildepth columns; special=2 marks water/lake class"
    - category: "parameter"
      name: "subbasin physiography (AREA, RIVLEN, latitude, elevation, slope, lake_depth, SLC_n fractions, parreg/wqparreg/lakeregion)"
      unit: "m^2, m, deg, m, %, fraction"
      source_kind: "dataset_lookup"
      model_input_format: "GeoData.txt — time-invariant subbasin descriptors; SLC fractions per subbasin must sum to 1.0"
      notes: "AREA in m^2 (discharge scales linearly with area); slope_mean mandatory for nutrient modelling."
  initial_conditions:
    - category: "initial_condition"
      name: "initial soil water"
      unit: "mm"
      source_kind: "default"
      model_input_format: "set to wp+fc (optionally saturation wp+fc+ep); or restored from state_save file"
      notes: "Hydrology needs ~1-2 yr warmup (bdate before cdate) for stable water states."
    - category: "initial_condition"
      name: "initial lake stage"
      unit: "m"
      source_kind: "default"
      model_input_format: "outlet/local lake water depth set at threshold (gldepi/illdepth)"
    - category: "initial_condition"
      name: "initial nutrient pools (humus/fast N and P: humusn0, fastn0, humusp0, fastp0)"
      unit: "kg/km2"
      source_kind: "default"
      model_input_format: "par.txt initial-pool parameters (humusn0, fastn0, humusp0, fastp0; genpar/landpar)"
      notes: "Initialization of the prognostic soil N/P pools; pools need ~3-5 yr warmup to stabilize seasonal pattern."
  boundary_conditions:
    - category: "boundary_condition"
      name: "simulation period (bdate / cdate / edate) and output/model options"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "info.txt — all directory paths must end in trailing '/'"
      notes: "Selects petmodel and snowmeltmodel options, substances ('substance N P'), output variables and criteria."
    - category: "boundary_condition"
      name: "PET method selector (petmodel 0-5)"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "info.txt modeloption petmodel"
      notes: "0-2 use temperature only; 3-5 add radiation/min-max temp; 5 adds humidity and wind."
    - category: "boundary_condition"
      name: "snowmelt method selector (snowmeltmodel)"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "info.txt modeloption snowmeltmodel"
    - category: "boundary_condition"
      name: "MAINDOWN routing topology"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "GeoData.txt MAINDOWN column; outlet = MAINDOWN 0"
      notes: "Must be acyclic with a terminating outlet; cycles cause an infinite routing loop."
    - category: "boundary_condition"
      name: "forcing-station mapping"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "ForcKey.txt (SUBID -> forcing station), in forcingdir"
    - category: "boundary_condition"
      name: "lake / dam regulation configuration"
      unit: "-"
      source_kind: "user_provided"
      model_input_format: "LakeData.txt / DamData.txt (rating curves, regvol, production flows, minflow, seasonal inflows)"
      notes: "Required if any SLC has special=2, else a zero-volume lake traps all water."
    - category: "boundary_condition"
      name: "upstream inflow, atmospheric deposition, point/non-point sources, aquifer exchange"
      unit: "various"
      source_kind: "user_provided"
      model_input_format: "internal MAINDOWN inflow; AtmdepData.txt, PointSourceData.txt, NonPointSourceData.txt, AquiferData.txt"
    - category: "boundary_condition"
      name: "crop fertilizer / management data"
      unit: "-"
      source_kind: "dataset_lookup"
      model_input_format: "CropData.txt — crop/fertilizer management decisions (sowing, fertilizer timing/rates); required when NPC enabled"
      notes: "Management input (fertilizer/crop decisions), not a calibrated physical coefficient."
    - category: "boundary_condition"
      name: "observed discharge (for calibration)"
      unit: "m^3/s"
      source_kind: "user_provided"
      model_input_format: "Qobs.txt (gauged subbasins); optpar.txt for calibration ranges/tasks"

processes:
  modules:
    - name: "AtmosphericProcesses"
      role: "process_solver"
      brief: "atm_proc.f90 — elevation correction of T/P per class, rain/snow partitioning, extraterrestrial and shortwave radiation, potential evapotranspiration (5 PET options: Jensen-Haise/McGuiness, Hargreaves-Samani, Priestley-Taylor, FAO Penman-Monteith), snowfall windshelter redistribution, daylength, cloudiness."
    - name: "SoilProcesses"
      role: "process_solver"
      brief: "soil_proc.f90 — snowpack accumulation/melt (degree-day and radiation index), snow density/depth/cover, infiltration, surface runoff, percolation, macropore flow, tile drainage, soil-layer recession runoff (rrcs1/rrcs2/rrcs3/srrcs), soil temperature and frost depth, frozen-water fraction, actual ET, groundwater table."
    - name: "SoilModelDefault"
      role: "driver"
      brief: "soilmodel0.f90 — default per-class soil-column driver: sequences snow, infiltration, ET, percolation, runoff and nutrient processes for a land class within the subbasin/class loop."
    - name: "GlacierSoilModel"
      role: "optional_module"
      brief: "glacier_soilmodel.f90 — glacier-class soil model adding glacier mass balance and melt."
      applicability: "glacier classes only"
    - name: "FloodplainSoilModel"
      role: "optional_module"
      brief: "soilmodel4.f90 — soil model for the non-flooded part of a floodplain class; couples soil column to floodplain surface water."
      applicability: "when modeloption p_floodplain >= 2"
    - name: "NPC_SoilProcesses"
      role: "process_solver"
      brief: "npc_soil_proc.f90 — soil N/P/organic-carbon pool dynamics: mineralization, plant uptake/growing season, denitrification, sorption, crop-rotation pool averaging, soil leakage."
      applicability: "when NPC (substance N/P) enabled"
    - name: "SurfaceWaterProcesses"
      role: "process_solver"
      brief: "sw_proc.f90 — rivers and lakes: river characteristics, translation/damping routing (rivvel, damp), evaporation, water temperature/T2 heat, river/lake ice, outlet-lake rating-curve and regulated outflow, branched/bifurcated flow, water stage, floodplain interflow, abstraction/transfer."
    - name: "NPC_SurfaceWaterProcesses"
      role: "process_solver"
      brief: "npc_sw_proc.f90 — substance (N/P/SS/OC) transformation, sedimentation/resuspension, point sources, atmospheric deposition and wetland processes in rivers and lakes."
      applicability: "when NPC enabled"
    - name: "LayeredLakeProcesses"
      role: "optional_module"
      brief: "ll_proc.f90 — optional vertically-layered (stratified) lake: layer volumes/concentrations, mixing, depth-resolved temperature (requires T2)."
      applicability: "when p_layeredlake enabled"
    - name: "RegionalGroundwater"
      role: "process_solver"
      brief: "regional_groundwater.f90 — aquifer/regional groundwater: removes water from soil profiles at top of timestep, explicit aquifer storage with delayed outflow, recharge, flow to rivers/olakes and out of domain."
      applicability: "when regional groundwater/aquifer enabled"
    - name: "IrrigationModule"
      role: "process_solver"
      brief: "irrigation.f90 — per-class irrigation demand and withdrawal from groundwater/lakes/rivers/external sources with one-timestep application delay."
      applicability: "when irrigation enabled"
    - name: "GeneralWaterConcentration"
      role: "integrator"
      brief: "general_wc.f90 — mass-conserving add_water/remove_water/error_remove_water primitives that update water volumes and mixed concentrations; used by every process module to move water+substances between stores."
    - name: "ModelCore"
      role: "driver"
      brief: "model_hype.f90 SUBROUTINE model — per-timestep orchestrator: regional GW removal -> atmospheric forcing -> snowfall distribution -> subbasin loop -> class loop (dispatch to soilmodel_0/3/4) -> river/lake routing in downstream flow order -> output accumulation. Configuration flows through MODVAR module globals, not arguments."
    - name: "COMPOUT"
      role: "integrator"
      brief: "compout.f90 — output-variable computation and period accumulation (initiate_outvar/revise_outvar/compute_mapoutput) plus performance-criteria calculation (calculate_criteria, calculate_median)."
  internal_edges:
    - from: "Inputs"
      to: "AtmosphericProcesses"
      kind: "consumes_input"
      brief: "Pobs/Tobs (and radiation/humidity/wind for PET 3-5) drive temperature/precip correction and PET."
    - from: "ModelCore"
      to: "RegionalGroundwater"
      kind: "invokes"
      brief: "At top of timestep, regional GW removal from soil before the subbasin loop."
    - from: "RegionalGroundwater"
      to: "soil water"
      kind: "writes_state"
      brief: "Removes groundwater outflow from soil profiles; re-adds aquifer flow to rivers/olakes later."
    - from: "ModelCore"
      to: "AtmosphericProcesses"
      kind: "invokes"
      brief: "Per-timestep subbasin temperature/precipitation, radiation, cloudiness, snowfall distribution."
    - from: "AtmosphericProcesses"
      to: "SoilModelDefault"
      kind: "invokes"
      brief: "Per-class corrected temp, precip, rain/snow split, radiation and PET feed the soil column."
    - from: "ModelCore"
      to: "SoilModelDefault"
      kind: "invokes"
      brief: "Class loop calls soilmodel_0 for each land class in each subbasin."
    - from: "ModelCore"
      to: "GlacierSoilModel"
      kind: "invokes"
      brief: "Glacier classes dispatched to soilmodel_3 + glacier mass balance."
    - from: "ModelCore"
      to: "FloodplainSoilModel"
      kind: "invokes"
      brief: "Floodplain classes dispatched to soilmodel_4 when p_floodplain >= 2."
    - from: "SoilModelDefault"
      to: "SoilProcesses"
      kind: "invokes"
      brief: "Calls snow, infiltration, percolation, ET, runoff and soil-temperature routines."
    - from: "SoilProcesses"
      to: "snow water equivalent"
      kind: "writes_state"
      brief: "calculate_snow updates SWE, snow depth, cover, age."
    - from: "SoilProcesses"
      to: "soil water"
      kind: "writes_state"
      brief: "Infiltration, percolation, runoff and ET update soil moisture per layer."
    - from: "SoilProcesses"
      to: "soil temperature"
      kind: "writes_state"
      brief: "calculate_soiltemp updates soil-layer temperature; drives frost depth and frozen-water fraction."
    - from: "SoilModelDefault"
      to: "NPC_SoilProcesses"
      kind: "invokes"
      brief: "Soil nutrient/OC pool transformation and plant uptake within the class loop."
    - from: "NPC_SoilProcesses"
      to: "soil nutrient pools"
      kind: "writes_state"
      brief: "Updates N/P/C soil pools (humusN/fastN/partP/fastP/humusC/fastC)."
    - from: "SoilProcesses"
      to: "IrrigationModule"
      kind: "invokes"
      brief: "Soil moisture deficit drives irrigation demand calculation."
    - from: "IrrigationModule"
      to: "soil water"
      kind: "writes_state"
      brief: "Computed irrigation queued (one-step delay) then applied to the soil column."
    - from: "SoilModelDefault"
      to: "river storage"
      kind: "writes_state"
      brief: "Class soil runoff aggregates to local stream / main river inflow."
    - from: "ModelCore"
      to: "SurfaceWaterProcesses"
      kind: "invokes"
      brief: "Routing of local river, ilake, main river, olake in downstream flow order."
    - from: "SurfaceWaterProcesses"
      to: "river storage"
      kind: "writes_state"
      brief: "Translation/damping update river volume and routing queue."
    - from: "SurfaceWaterProcesses"
      to: "lake storage"
      kind: "writes_state"
      brief: "Outlet-lake rating-curve / regulated outflow updates lake water stage."
    - from: "ModelCore"
      to: "NPC_SurfaceWaterProcesses"
      kind: "invokes"
      brief: "Substance processes, sedimentation/resuspension, point sources and deposition in river/lake."
    - from: "NPC_SurfaceWaterProcesses"
      to: "river/lake substance and sediment pools"
      kind: "writes_state"
      brief: "Sediment/P/T1 sediment pools and lake sediment pool updated."
    - from: "ModelCore"
      to: "LayeredLakeProcesses"
      kind: "invokes"
      brief: "When p_layeredlake on, stratified lake layer volumes/concentrations updated."
    - from: "SurfaceWaterProcesses"
      to: "RegionalGroundwater"
      kind: "invokes"
      brief: "River-aquifer coupling (calculate_river_groundwaterflow_removal, add_aquifer_flow_to_river)."
    - from: "AtmosphericProcesses"
      to: "GeneralWaterConcentration"
      kind: "invokes"
      brief: "All process modules use add_water/remove_water primitives to move water+substances (mass conservation)."
    - from: "SoilProcesses"
      to: "GeneralWaterConcentration"
      kind: "invokes"
      brief: "Soil moisture and runoff transfers mediated by mass-conserving primitives."
    - from: "SurfaceWaterProcesses"
      to: "GeneralWaterConcentration"
      kind: "invokes"
      brief: "River/lake water and substance transfers mediated by mass-conserving primitives."
    - from: "SurfaceWaterProcesses"
      to: "Outputs"
      kind: "produces_output"
      brief: "Routed olake/subbasin outflow (cout) and lake water stage emitted."
    - from: "ModelCore"
      to: "COMPOUT"
      kind: "produces_output"
      brief: "initiate_outvar/revise_outvar accumulate per-timestep output variables and map output."

