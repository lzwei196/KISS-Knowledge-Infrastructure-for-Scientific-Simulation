safety:
  hazards:
    - id: "slc_fractions_not_summing_to_one"
      kind: "soil_semantic"
      description: "SLC fractions per subbasin in GeoData.txt not summing to 1.0 silently drops the deficit fraction of precipitation, biasing the water balance with no warning (exit 0)."
      severity: "silent"
    - id: "area_unit_km2_vs_m2"
      kind: "soil_semantic"
      description: "AREA in GeoData.txt given in km^2 instead of m^2 scales simulated discharge by ~10^6; HYPE expects m^2 and gives no warning."
      severity: "silent"
    - id: "soil_retention_ordering_violation"
      kind: "soil_semantic"
      description: "Soil parameters violating wcwp<wcfc<wcep (or wcwp+wcfc+wcep>=1) prevent percolation, yielding zero discharge while the model runs."
      severity: "silent"
    - id: "streamdepth_zero_zero_runoff"
      kind: "soil_semantic"
      description: "GeoClass streamdepth (col 10) = 0 makes soil-runoff generation return early, producing zero discharge despite valid precipitation (undocumented)."
      severity: "silent"
    - id: "water_class_missing_special_code"
      kind: "soil_semantic"
      description: "Water/lake SLC class not marked special=2 in GeoClass.txt is treated as land with soil processes, so lake regulation is silently ignored."
      severity: "silent"
    - id: "zero_volume_lake_trap"
      kind: "soil_semantic"
      description: "SLC special=2 set without a LakeData.txt entry creates a zero-volume lake that traps all routed water."
      severity: "silent"
    - id: "par_value_count_mismatch"
      kind: "coefficient_runtime_silent_fallback"
      description: "par.txt value count fewer than the MAX land-use/soil ID in GeoClass.txt (count by highest ID, not unique count) is a fatal 'too few values'; extra values are ignored with a warning."
      severity: "fatal_or_silent"
    - id: "nutrient_params_missing_silent_disable"
      kind: "coefficient_runtime_silent_fallback"
      description: "info.txt enabling 'substance N P' without the required nutrient parameters in par.txt silently disables nutrient processes; concentration outputs are all zero, model still runs."
      severity: "silent"
    - id: "geoclass_numlayers_mismatch"
      kind: "soil_semantic"
      description: "GeoClass numlayers (col 11) outside 1-3, or a soildepth column count mismatch, is fatal ('No or too many soil layers') and can silently shift downstream column parsing."
      severity: "fatal_or_silent"
    - id: "forcing_date_coverage_gap"
      kind: "weather_file_semantic"
      description: "Pobs/Tobs not covering the full bdate-edate range causes a fatal date-mismatch ('ERROR read Pobs, date not equal'); HYPE performs no interpolation or fill."
      severity: "fatal"
    - id: "forcing_comment_or_header_parser_misparse"
      kind: "parser_semantic"
      description: "Comment rows not following HYPE's '!! '-prefixed convention (e.g. '!!' lines above the column header in Pobs/Tobs/par.txt, or a missing header on line 1) cause the Fortran reader to misparse columns, silently yielding wrong (e.g. all-zero) forcing or crashing the run."
      severity: "fatal_or_silent"
    - id: "forckey_subid_mismatch"
      kind: "control_semantic"
      description: "ForcKey.txt SUBIDs not matching GeoData.txt leave the unmatched subbasins running with zero precipitation, so they contribute no flow."
      severity: "silent"
    - id: "maindown_cycle_or_no_outlet"
      kind: "control_semantic"
      description: "A MAINDOWN cycle, or no terminating outlet (MAINDOWN=0), produces an infinite routing loop / crash."
      severity: "fatal"
    - id: "rivlen_zero_no_routing_delay"
      kind: "control_semantic"
      description: "RIVLEN ~0 in GeoData.txt removes routing delay (transtime = rivlen/(rivvel*86400)), giving an unrealistically peaky hydrograph."
      severity: "degraded"
  validation_limits:
    - "Daily operational timestep cannot resolve sub-daily processes; sub-daily validity of PET models 3-5 and some equations is uncertain."
    - "Lumped (1-subbasin) setups of large basins (>10,000 km^2) lack subbasin-to-subbasin routing attenuation and over-predict peaks."
    - "Lumped setups produce unrealistic dissolved IN/SP nutrient concentrations (no downstream export); use 3+ subbasins for NPC."
    - "Recharge-discharge (regional groundwater) model excludes glacier and surface-water classes and classes using rootzone-leakage/travel-time soil models."
    - "Algorithms are conceptual, not purely physical; the model is largely manually calibrated and not skillful uncalibrated."
    - "subid must be an integer < 10^7."
  warnings:
    - "Use re* nutrient variables only with observed nutrient data; use c1* for modelled concentrations."
    - "c1TN/c1TP are concentrations (ug/L), not areal loads (kgN/ha/yr); they are different quantities and require an explicit conversion path."
    - "Lumped lake setups may over-attenuate the hydrograph; regulated-lake constant-area-with-depth assumption can bias water-level amplitude (mitigate via wamp)."
    - "Generated lake rating curves and DamData monthly natural inflows are estimates that need calibration."
    - "Hydrology needs ~1-2 yr warmup (bdate before cdate); N/P pools need ~3-5 yr to stabilize."
  assumptions:
    - statement: "Each subbasin's water balance is computed per SLC (Soil-Land use Combination) fraction and aggregated to the subbasin; land classes are independent unless the recharge-discharge model is enabled."
      scope: "spatial discretization (HRU-like SLC fractions)"
      source: "HYPE wiki Land routines (hype.smhi.net hype_land) and Lindstrom et al. 2010 (DOI 10.2166/nh.2010.007)"
      status: "adopted"
    - statement: "Water balance is mass-conservative; substances are carried as concentrations following each water flux plus immobile soil/sediment pools, with no surface energy-balance closure (PET is a conceptual demand-side flux)."
      scope: "conservation / closure"
      source: "HYPE wiki model description (hype.smhi.net hype_model_description) and GeneralWaterConcentration (general_wc.f90) add_water/remove_water primitives"
      status: "adopted"
    - statement: "Routing is internal along the MAINDOWN topology terminating at a single outlet (MAINDOWN=0); all land runoff routes through the local river before reaching outlet lakes (no direct land-to-lake runoff)."
      scope: "routing topology"
      source: "HYPE wiki Rivers and lakes (hype.smhi.net hype_routing)"
      status: "adopted"
    - statement: "Maximum soil discretization is 3 layers with the root zone fixed to the top 2 layers; maximum 11 simultaneously-simulated water-quality substances."
      scope: "vertical/substance discretization limits"
      source: "HYPE source modvar.f90 (maxsoillayers=3, nrootzone=2, max_substances=11)"
      status: "adopted"
    - statement: "Initial soil water is set to wilting point + field capacity (optionally to saturation) and lakes start at threshold stage; nutrient pools initialize from par.txt and require multi-year warmup."
      scope: "initial conditions"
      source: "HYPE wiki Land routines initial soil water; KI parameter initialization (humusn0/fastn0/humusp0/fastp0)"
      status: "adopted"
