    - name: "glacier ice volume"
      unit: "m^3"
      role: "prognostic"
    - name: "soil water"
      unit: "mm"
      role: "prognostic"
    - name: "soil temperature"
      unit: "degC"
      role: "prognostic"
    - name: "groundwater table"
      unit: "m"
      role: "prognostic"
    - name: "frost depth"
      unit: "m"
      role: "diagnostic"
    - name: "river storage"
      unit: "m^3"
      role: "prognostic"
    - name: "river/lake routing queue"
      unit: "m^3"
      role: "prognostic"
    - name: "river temperature (and 10/20-day moving averages)"
      unit: "degC"
