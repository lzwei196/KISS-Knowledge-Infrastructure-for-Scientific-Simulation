# Python bytecode. Tracked .pyc files are platform-stamped (cpython-312),
# rebuilt on import, and a stale one can shadow a module just updated.
__pycache__/
*.py[cod]

# Editor backups, referenced by nothing.
*.bak
*.bak.*
*.orig
*~

# Build output. The release workflow builds from a clean checkout, so these
# only ever arrive by accident from a local build.
build/
dist/
*.spec
.build-venv/
*.egg-info/

# Model run residue. Running a model from the repository root leaves these;
# ERROR.OUT, fort.502, LUN.LST and WARNING.OUT all reached a commit this way.
ERROR.OUT
WARNING.OUT
LUN.LST
fort.*

# macOS
.DS_Store

# Suffixed local build outputs (dist-<tag>-vX.Y.Z etc.) and a stray app bundle at the root.
kiss/dist-*/
kiss/build-*/
kiss/.pyinstaller-*/
/GeoForge Desktop.app/

# Local data, releases and experiment runs: never source.
/acceptance/
/releases/
/kiss/releases/
/.stress-kimi*/
/git_examples/
/auto_dissect_general/
/auto_dissect_general.zip
/ArchDam-RDC-KI/
/output/
/kiss/product-book/
*.log
