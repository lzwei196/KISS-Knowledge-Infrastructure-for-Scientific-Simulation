outputs:
  - var: "cout"
    validation_rank: 1
    unit: "m^3/s"
    description: "Simulated outflow (discharge) from the outlet lake / subbasin"
    emitted_in: "timeCOUT.txt / basinoutput"
    observability:
      comparable_obs_shapes:
        - obs_shape: "point_time_series"
          comparison_mode: "time_series_comparison"
          metric_families: ["temporal_pattern_match", "magnitude_accuracy"]
          determining_metric: "nse"
          caveats:
            - "Compare at gauged subbasin outlets; ensure simulated and observed drainage areas match (discharge scales linearly with AREA)."
            - "Allow warmup (bdate..cdate) before scoring; daily timestep cannot resolve sub-daily peaks."
            - "Lumped (1-subbasin) setups of large basins lack routing attenuation and over-predict peaks."
        - obs_shape: "spatial_time_series"
          comparison_mode: "spatial_field_comparison"
          metric_families: ["spatial_pattern_match", "magnitude_accuracy"]
          determining_metric: "csi"
          caveats:
            - "Multi-subbasin discharge fields compared only where gauges exist per subbasin."
      detrending_options: ["none"]
  - var: "snow"
    validation_rank: 2
    unit: "mm"
    description: "Snow water equivalent, subbasin land-area average"
    emitted_in: "timeSNOW.txt"
    observability:
      comparable_obs_shapes:
        - obs_shape: "point_time_series"
          comparison_mode: "time_series_comparison"
          metric_families: ["temporal_pattern_match", "timing_accuracy", "magnitude_accuracy"]
          determining_metric: "nse"
          caveats:
            - "SWE point obs (e.g. SNOTEL-type) vs subbasin average differ in support scale."
        - obs_shape: "spatial_snapshot"
          comparison_mode: "spatial_field_comparison"
          metric_families: ["spatial_pattern_match"]
          determining_metric: "csi"
          caveats:
            - "Snow-cover/SWE maps compared at a single instant; subbasin aggregation smooths spatial detail."
      detrending_options: ["none"]
  - var: "evap"
    validation_rank: 3
    unit: "mm/day"
    description: "Actual evapotranspiration"
    emitted_in: "timeEVAP.txt"
    observability:
      comparable_obs_shapes:
        - obs_shape: "point_time_series"
          comparison_mode: "time_series_comparison"
          metric_families: ["temporal_pattern_match", "magnitude_accuracy"]
          determining_metric: "nse"
          caveats:
            - "ET is a conceptual demand-side flux (no energy-balance closure); compare against flux-tower or remote-sensing ET with that caveat."
