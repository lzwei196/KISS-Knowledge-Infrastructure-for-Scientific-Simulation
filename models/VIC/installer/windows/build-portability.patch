--- /dev/null
+++ b/vic/drivers/classic/include/strptime_mingw.c
@@ -0,0 +1,292 @@
+/******************************************************************************
+ * @section DESCRIPTION
+ *
+ * strptime() implementation for MinGW.
+ *
+ * MinGW-w64 provides strftime() but not strptime(), which VIC uses in
+ * strpdmy() (shared_all/src/vic_time.c) to parse the date line of a model
+ * state file.
+ *
+ * This implements the subset of POSIX strptime() that VIC relies on:
+ *   %Y  four-digit year          %m  month [01-12]
+ *   %d  day of month [01-31]     %H  hour   [00-23]
+ *   %M  minute [00-59]           %S  second [00-60]
+ *   %j  day of year [001-366]
+ * plus literal characters and %%.
+ *
+ * Fields are written into struct tm with the same conventions as glibc:
+ * tm_year is years since 1900 and tm_mon is 0-11, so callers that pre-seed
+ * tm_mon/tm_mday/tm_hour/tm_min/tm_sec still see POSIX behaviour.
+ *
+ * This is a platform-completeness shim only; no VIC scientific logic changes.
+ *****************************************************************************/
+
+#include <time.h>
+#include <string.h>
+#include <ctype.h>
+
+#ifndef VIC_HAVE_STRPTIME
+
+char *strptime(const char *s, const char *format, struct tm *tm)
+{
+    const char *sp;
+    const char *fp;
+    int         n;
+    int         val;
+
+    if ((s == NULL) || (format == NULL) || (tm == NULL)) {
+        return NULL;
+    }
+
+    sp = s;
+    fp = format;
+
+    while (*fp != '\0') {
+        /* Skip whitespace in the format: match any run of whitespace. */
+        if (isspace((unsigned char) *fp)) {
+            while (isspace((unsigned char) *fp)) {
+                fp++;
+            }
+            while (isspace((unsigned char) *sp)) {
+                sp++;
+            }
+            continue;
+        }
+
+        if (*fp != '%') {
+            if (*fp != *sp) {
+                return NULL;
+            }
+            fp++;
+            sp++;
+            continue;
+        }
+
+        /* We are at a '%' conversion. */
+        fp++;
+        if (*fp == '\0') {
+            return NULL;
+        }
+
+        /* Optional width limit, e.g. %04d style is not used by VIC, but
+         * accept and ignore digits/flags so real-world formats still parse. */
+        while (*fp == '0' || *fp == 'E' || *fp == 'O') {
+            fp++;
+        }
+
+        switch (*fp) {
+        case '%':
+            if (*sp != '%') {
+                return NULL;
+            }
+            sp++;
+            break;
+
+        case 'Y':
+            /* Four-digit year. */
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 4)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if (n == 0) {
+                return NULL;
+            }
+            tm->tm_year = val - 1900;
+            break;
+
+        case 'y':
+            /* Two-digit year: POSIX maps 69-99 -> 1969-1999, 00-68 -> 2000-2068. */
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if (n == 0) {
+                return NULL;
+            }
+            tm->tm_year = (val < 69) ? val + 100 : val;
+            break;
+
+        case 'm':
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val < 1) || (val > 12)) {
+                return NULL;
+            }
+            tm->tm_mon = val - 1;
+            break;
+
+        case 'd':
+        case 'e':
+            n = 0;
+            val = 0;
+            while (isspace((unsigned char) *sp) && (*fp == 'e')) {
+                sp++;
+            }
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val < 1) || (val > 31)) {
+                return NULL;
+            }
+            tm->tm_mday = val;
+            break;
+
+        case 'H':
+        case 'k':
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val > 23)) {
+                return NULL;
+            }
+            tm->tm_hour = val;
+            break;
+
+        case 'M':
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val > 59)) {
+                return NULL;
+            }
+            tm->tm_min = val;
+            break;
+
+        case 'S':
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 2)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val > 61)) {
+                return NULL;
+            }
+            tm->tm_sec = val;
+            break;
+
+        case 'j':
+            /* Day of year [001-366].  VIC seeds tm_mon/tm_mday before calling,
+             * so derive month/day from the ordinal the same way glibc does. */
+            n = 0;
+            val = 0;
+            while (isdigit((unsigned char) *sp) && (n < 3)) {
+                val = val * 10 + (*sp - '0');
+                sp++;
+                n++;
+            }
+            if ((n == 0) || (val < 1) || (val > 366)) {
+                return NULL;
+            }
+            tm->tm_yday = val - 1;
+            break;
+
+        case 'b':
+        case 'B':
+        case 'h':
+        {
+            /* Abbreviated or full month name. */
+            static const char *names[12] = {
+                "January", "February", "March", "April", "May", "June",
+                "July", "August", "September", "October", "November", "December"
+            };
+            int i;
+            int matched = -1;
+
+            for (i = 0; i < 12; i++) {
+                size_t len = ((*fp == 'b') || (*fp == 'h')) ? 3u : strlen(names[i]);
+                size_t k;
+
+                for (k = 0; k < len; k++) {
+                    if (tolower((unsigned char) sp[k]) !=
+                        tolower((unsigned char) names[i][k])) {
+                        break;
+                    }
+                }
+                if (k == len) {
+                    matched = i;
+                    sp += len;
+                    break;
+                }
+            }
+            if (matched < 0) {
+                return NULL;
+            }
+            tm->tm_mon = matched;
+            break;
+        }
+
+        case 'a':
+        case 'A':
+            /* Weekday name: consume it, VIC derives weekday itself. */
+        {
+            static const char *days[7] = {
+                "Sunday", "Monday", "Tuesday", "Wednesday",
+                "Thursday", "Friday", "Saturday"
+            };
+            int i;
+            int matched = -1;
+
+            for (i = 0; i < 7; i++) {
+                size_t len = (*fp == 'a') ? 3u : strlen(days[i]);
+                size_t k;
+
+                for (k = 0; k < len; k++) {
+                    if (tolower((unsigned char) sp[k]) !=
+                        tolower((unsigned char) days[i][k])) {
+                        break;
+                    }
+                }
+                if (k == len) {
+                    matched = i;
+                    sp += len;
+                    break;
+                }
+            }
+            if (matched < 0) {
+                return NULL;
+            }
+            break;
+        }
+
+        case 'n':
+        case 't':
+            while (isspace((unsigned char) *sp)) {
+                sp++;
+            }
+            break;
+
+        default:
+            /* Unsupported conversion: fail loudly rather than mis-parse. */
+            return NULL;
+        }
+
+        fp++;
+    }
+
+    return (char *) sp;
+}
+
+#endif /* VIC_HAVE_STRPTIME */
