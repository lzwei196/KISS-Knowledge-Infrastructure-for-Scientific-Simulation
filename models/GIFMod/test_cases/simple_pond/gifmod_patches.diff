@@ -18,6 +27,62 @@ int main(int argc, char *argv[])
     ScriptingEngine::registerClass<JSTest>();	
     mainGUIwindow.show();
 	mainGUIwindow.afterInit();
+	// ---- headless driver (added 2026-10-06, engine_builds) ----
+	// GIFMod --wizard T.wiz [--param name=value ...] --save out.GIFMod   (build model from a bundled template, save, run)
+	// GIFMod --script S.scr --save out.GIFMod                           (build model from a GIFMod script, save, run)
+	// GIFMod --model M.GIFMod                                            (load saved project, run)
+	{
+		QStringList a = GUI.arguments();
+		QString wizFile, scrFile, modelFile, saveFile; QMap<QString,QString> params;
+		for (int i = 1; i < a.size(); i++) {
+			if (a[i] == "--wizard" && i+1 < a.size()) wizFile = a[++i];
+			else if (a[i] == "--script" && i+1 < a.size()) scrFile = a[++i];
+			else if (a[i] == "--model" && i+1 < a.size()) modelFile = a[++i];
+			else if (a[i] == "--save" && i+1 < a.size()) saveFile = a[++i];
+			else if (a[i] == "--param" && i+1 < a.size()) { QString kv = a[++i]; int k = kv.indexOf('='); params[kv.left(k)] = kv.mid(k+1); }
+		}
+		if (!wizFile.isEmpty() || !scrFile.isEmpty() || !modelFile.isEmpty()) {
+			QTextStream out(stdout);
+			qputenv("GIFMOD_HEADLESS", "1");
+			// auto-dismiss any modal dialog (e.g. "Simulation Finished!") so the run never waits for a click
+			QTimer *modalKiller = new QTimer(&GUI);
+			QObject::connect(modalKiller, &QTimer::timeout, [&]() {
+				QWidget *m = QApplication::activeModalWidget();
+				if (m) { QMessageBox *mb = qobject_cast<QMessageBox*>(m); fprintf(stdout, "HEADLESS: auto-closed dialog '%s': %s\n", m->windowTitle().toStdString().c_str(), mb ? mb->text().toStdString().c_str() : ""); fflush(stdout); m->close(); }
+			});
+			modalKiller->start(300);
+			if (!modelFile.isEmpty()) {
+				bool lok = false; QMetaObject::invokeMethod(&mainGUIwindow, "loadModel", Qt::DirectConnection, Q_RETURN_ARG(bool, lok), Q_ARG(QString, QFileInfo(modelFile).absoluteFilePath()));
+				if (!lok) { out << "HEADLESS: cannot load " << modelFile << endl; return 2; }
+			} else {
+				QList<CCommand> commands;
+				if (!wizFile.isEmpty()) {
+					Wizard_Script_Reader wiz(QFileInfo(wizFile).absoluteFilePath());
+					wiz.mproplist = mainGUIwindow.mainGraphWidget->mList;
+					for (QString k : wiz.get_parameters().keys()) { QString dv = wiz.get_parameters()[k].get_parameter("default").value.trimmed(); if (!dv.isEmpty() && !params.contains(k)) { XString x(dv); wiz.get_parameters()[k].set_value(x); out << "DEFAULT: " << k << "=" << dv << endl; } }
+					for (QString k : params.keys()) { XString x(params[k]); wiz.get_parameters()[k].set_value(x); }
+					QStringList errors = wiz.validate();
+					if (errors.size()) { out << "HEADLESS: wizard errors:" << endl << errors.join("\n") << endl; return 3; }
+					commands = wiz.get_script_commands();
+				} else {
+					QFile f(scrFile); if (!f.open(QIODevice::ReadOnly)) { out << "HEADLESS: cannot open " << scrFile << endl; return 2; }
+					QTextStream ss(&f); while (!ss.atEnd()) { QString l = ss.readLine(); if (l.trimmed().size()) commands.append(CCommand(l)); }
+				}
+				for (int i = 0; i < commands.size(); i++) out << "CMD: " << commands[i].toQString() << endl;
+				mainGUIwindow.mainGraphWidget->runCommands(commands);
+				if (saveFile.isEmpty()) saveFile = "headless_model.GIFMod";
+				mainGUIwindow.setModelFileName(QFileInfo(saveFile).absoluteFilePath());
+				QMetaObject::invokeMethod(&mainGUIwindow, "on_action_Save_triggered", Qt::DirectConnection);
+				out << "HEADLESS: model saved to " << QFileInfo(saveFile).absoluteFilePath() << endl;
+			}
+			out << "HEADLESS: running forward model" << endl; out.flush();
+			bool ok = QMetaObject::invokeMethod(&mainGUIwindow, "on_actionRun_Model_triggered", Qt::DirectConnection);
+			mainGUIwindow.mainGraphWidget->logW->writetotempfile();
+			out << "HEADLESS: run invoked=" << ok << " hasResults=" << mainGUIwindow.mainGraphWidget->hasResults << endl;
+			return mainGUIwindow.mainGraphWidget->hasResults ? 0 : 4;
+		}
+	}
+	// ---- end headless driver ----
 	QEventLoop loop;
 	return GUI.exec();
 }
