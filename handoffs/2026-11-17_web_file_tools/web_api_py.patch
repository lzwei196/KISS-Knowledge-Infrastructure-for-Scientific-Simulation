+# --- line-numbered reads, name patterns (local patch 2026-11-17, VENDOR_PATCHES.md #3) ---
+
+def _read_text_window(p: Path, display: str, args: dict, max_bytes: int) -> str:
+    try:
+        offset, limit = _ft.read_args(args)
+        if p.stat().st_size > 200_000_000:
+            raise _ft.FileToolError(f"{display} is too large for the text reader (over 200 MB); "
+                                    "use search_files or a KI tool")
+        with open(p, "rb") as f:
+            if b"\0" in f.read(8192):
+                raise _ft.FileToolError(f"{display} is not a text file; use a data or KI tool to look inside it")
+        return _ft.read_window(p, display, offset, limit, max_bytes)
+    except _ft.FileToolError as e:
+        raise ToolError(str(e)) from None
+
+
+def _name_filter(raw, base_rel: str):
+    """None (no pattern) or a test on a root-relative path, with list_ki_files' pattern rules:
+    plain words must all be in the file name; with * ? or / a path glob (** crosses folders),
+    read from ``base_rel`` when it does not already start there."""
+    if raw is None or not str(raw).strip():
+        return None
+    pat, words, by_name, plain_path = _ki_clean_pattern(str(raw))
+    pre = "" if base_rel in ("", ".") else base_rel.rstrip("/") + "/"
+    if words:
+        return lambda rel: all(_ki_word_in(w, rel.rsplit("/", 1)[-1].lower()) for w in words)
+    if by_name:
+        rx = _ki_glob_regex(pat)
+        return lambda rel: bool(rx.match(rel.rsplit("/", 1)[-1]))
+    if pre and not pat.lower().startswith(pre.lower()):
+        pat = pre + pat
+    if plain_path:
+        rx_dir, rx_start = _ki_glob_regex(pat.rstrip("/") + "/**"), _ki_glob_regex(pat + "**")
+        return lambda rel: bool(rx_dir.match(rel) or rx_start.match(rel))
+    rx = _ki_glob_regex(pat)
+    return lambda rel: bool(rx.match(rel))
+
+
+_NUMBERED_RE = re.compile(r"(\d+): ")
+
+
+def _looks_line_numbered(content: str) -> bool:
+    """3+ lines that all start with consecutive numbers 'N: ', as read output shows them."""
+    rows = content.splitlines()
+    if len(rows) < 3:
+        return False
+    nums = []
+    for row in rows:
+        m = _NUMBERED_RE.match(row)
+        if not m:
+            return False
+        nums.append(int(m.group(1)))
+    return all(b == a + 1 for a, b in zip(nums, nums[1:]))
+
+
+def _capped_list(names: list[str], cap: int) -> str:
+    out = "\n".join(names[:cap])
+    if len(names) > cap:
+        out += f"\n(showing {cap} of {len(names)} files: use pattern=... or subdir=... to narrow it)"
+    return out
+
