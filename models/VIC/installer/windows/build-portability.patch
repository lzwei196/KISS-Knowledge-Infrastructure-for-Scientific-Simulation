@@ -0,0 +1,8 @@
+#ifndef VIC_WIN_SYS_TIME_H
+#define VIC_WIN_SYS_TIME_H
+/* MinGW has no <sys/time.h>.  VIC needs only gettimeofday() (timing.c).
+ * Let MinGW's own <time.h> define `struct timeval`, then take the shim's
+ * gettimeofday() declaration. */
+#include <time.h>
+#include <vic_compat_win.h>
+#endif
--- /dev/null
+++ b/vic/drivers/classic/include/vic_compat_win.h
@@ -0,0 +1,154 @@
+/******************************************************************************
+ * @section DESCRIPTION
+ *
+ * Windows/MinGW portability shim for VIC 5.1.0.
+ *
+ * VIC's headers unconditionally include POSIX-only headers that MinGW-w64 does
+ * not provide: <pwd.h>, <sys/time.h> and <execinfo.h>.  This shim supplies the
+ * declarations VIC actually needs so that the *unmodified* upstream sources
+ * compile with a MinGW gcc toolchain.
+ *
+ * It is force-included with -include before every translation unit, and
+ * wrapper headers named pwd.h / sys/time.h / execinfo.h sit earlier on the
+ * include path so those system includes resolve here instead of failing.
+ *
+ * Only OS-level facilities that MinGW genuinely lacks are shimmed.  Where
+ * MinGW already supplies a type (notably `struct timeval`, defined in MinGW's
+ * own <_timeval.h>) that definition is used rather than redefined.
+ *
+ * No model algorithm, constant or scientific default is changed.
+ *****************************************************************************/
+
+#ifndef VIC_COMPAT_WIN_H
+#define VIC_COMPAT_WIN_H
+
+#ifdef _WIN32
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <windows.h>
+#include <sys/types.h>
+
+/* ---------------------------------------------------------------------------
+ * uid_t / gid_t.
+ *
+ * MinGW defines pid_t but not the POSIX user/group ids.  VIC uses them only as
+ * opaque handles for the log/timing attribution below.
+ * ------------------------------------------------------------------------- */
+typedef int uid_t;
+typedef int gid_t;
+
+/* ---------------------------------------------------------------------------
+ * <pwd.h> replacement.
+ *
+ * vic_log.c calls getpwuid(getuid())->pw_name to tag log output with the user
+ * name.  MinGW has no passwd database, so return an empty string and let VIC
+ * fall back to its own default.
+ * ------------------------------------------------------------------------- */
+struct passwd {
+    char  *pw_name;
+    char  *pw_passwd;
+    uid_t  pw_uid;
+    gid_t  pw_gid;
+    char  *pw_gecos;
+    char  *pw_dir;
+    char  *pw_shell;
+};
+
+static inline uid_t getuid(void)
+{
+    return (uid_t) 0;
+}
+
+static inline uid_t geteuid(void)
+{
+    return (uid_t) 0;
+}
+
+static inline struct passwd *getpwuid(uid_t uid)
+{
+    static struct passwd pw;
+
+    (void) uid;
+    pw.pw_name = (char *) "";
+    pw.pw_passwd = (char *) "";
+    pw.pw_gecos = (char *) "";
+    pw.pw_dir = (char *) "";
+    pw.pw_shell = (char *) "";
+    pw.pw_uid = (uid_t) 0;
+    pw.pw_gid = (gid_t) 0;
+    return &pw;
+}
+
+/* ---------------------------------------------------------------------------
+ * <sys/time.h> replacement.
+ *
+ * MinGW supplies `struct timeval` via <_timeval.h> (pulled in by <time.h>), so
+ * only gettimeofday() -- used by timing.c -- needs supplying.
+ * ------------------------------------------------------------------------- */
+static inline int gettimeofday(struct timeval *tv, void *tz)
+{
+    (void) tz;
+    if (tv != NULL) {
+        tv->tv_sec = (long) time(NULL);
+        tv->tv_usec = 0;
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * <execinfo.h> replacement.
+ *
+ * vic_log.h includes <execinfo.h> and vic_log.c implements print_trace() via
+ * backtrace()/backtrace_symbols().  MinGW provides neither, so supply no-op
+ * stubs.  The crash backtrace is unavailable on this platform: that affects
+ * diagnostics only, never the simulation.
+ * ------------------------------------------------------------------------- */
+static inline int backtrace(void **buffer, int size)
+{
+    (void) buffer;
+    (void) size;
+    return 0;
+}
+
+static inline char **backtrace_symbols(void *const *buffer, int size)
+{
+    (void) buffer;
+    (void) size;
+    return NULL;
+}
+
+static inline void backtrace_symbols_fd(void *const *buffer, int size, int fd)
+{
+    (void) buffer;
+    (void) size;
+    (void) fd;
+}
+
+/* ---------------------------------------------------------------------------
+ * POSIX <unistd.h> pieces that MinGW's unistd.h does not provide.
+ * ------------------------------------------------------------------------- */
+#if !defined(_SSIZE_T_DEFINED) && !defined(_SSIZE_T_DEFINED_)
+#define _SSIZE_T_DEFINED
+typedef intptr_t ssize_t;
+#endif
+
+#ifndef STDIN_FILENO
+#define STDIN_FILENO  0
+#define STDOUT_FILENO 1
+#define STDERR_FILENO 2
+#endif
+
+/* Some VIC sources reference these POSIX status macros. */
+#ifndef EXIT_SUCCESS
+#define EXIT_SUCCESS 0
+#endif
+#ifndef EXIT_FAILURE
+#define EXIT_FAILURE 1
+#endif
+
+#endif /* _WIN32 */
+
+#endif /* VIC_COMPAT_WIN_H */
